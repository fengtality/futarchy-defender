# Copy to .env (setup.sh does this for you) and keep it PRIVATE.
# These are local secrets for YOUR machine only — never commit .env.

# Encrypts your wallet keystore inside Gateway. setup.sh generates a random one.
GATEWAY_PASSPHRASE=change-me

# Unlocks the Hummingbot console non-interactively. setup.sh generates a random one.
CONFIG_PASSWORD=change-me
